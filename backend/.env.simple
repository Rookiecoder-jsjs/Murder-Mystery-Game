# ===== 使用方式 =====
# 复制为 .env 填入真实密钥：cp .env.simple .env
# .env 已被根目录 .gitignore 忽略，绝不会被提交；
# 启动时若缺少 DEEPSEEK_API_KEY，后端会直接报错并退出（fail fast）。

# ===== 故事生成（DeepSeek V4 Pro，思考模式默认开启）=====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== 角色扮演（DeepSeek V4 Flash，思考模式默认关闭以保证低延迟）=====
# 不单独设置时自动复用 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
ROLEPLAY_MODEL=deepseek-v4-flash
# ROLEPLAY_API_KEY=
# ROLEPLAY_BASE_URL=

# 角色生成参数（可选 — 默认值如下）
ROLEPLAY_TEMPERATURE=1.0
ROLEPLAY_TOP_P=0.95
ROLEPLAY_MAX_TOKENS=2048
# 角色扮演是否开启思考模式（开启后 temperature/top_p 失效，延迟上升）
# ROLEPLAY_THINKING_ENABLED=false

# ===== 角色肖像生成（DashScope / Qwen Image 3.0）=====
# 不配置时会跳过肖像生成，游戏仍可正常使用首字母头像。
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
# 竖幅人物档案照（宽*高，范围由模型决定）
DASHSCOPE_IMAGE_SIZE=1024*1536
# 并发数控制成本与限流；推荐保持 2。
DASHSCOPE_IMAGE_MAX_WORKERS=2
# DASHSCOPE_IMAGE_TIMEOUT_SECONDS=150
# DASHSCOPE_IMAGE_POLL_INTERVAL_SECONDS=3

# CORS allowed origins (comma-separated). Default: localhost dev ports.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Application log level (DEBUG, INFO, WARNING, ERROR). Default: INFO.
# LOG_LEVEL=INFO

# 会话持久化目录（不设则仅内存存储；设置后重启自动恢复）
# 相对路径以 backend/ 为基准（例如 sessions → backend/sessions）
# SESSIONS_DIR=sessions

# ===== LLM 调用追踪（JSONL，用于排查模型输入输出与思考过程）=====
# 每次大模型调用落一条记录到 backend/logs/llm/YYYY-MM-DD.jsonl，
# 含完整 messages、输出、思考过程（reasoning）、耗时、token 用量与错误。
# 默认开启；排障后可设为 0 关闭。
# LLM_TRACE_ENABLED=1
# 输出目录（相对 backend/ 或绝对路径）
# LLM_TRACE_DIR=logs/llm
# 单条消息正文/思考最大保留字符数，超出截断防文件膨胀
# LLM_TRACE_MAX_BODY_CHARS=20000
