# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner

# MiniMax API (OpenAI compatible)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.com/v1
MINIMAX_MODEL=M2-her

# OpenAI compatible base URL
OPENAI_BASE_URL=https://api.minimax.com/v1
OPENAI_API_KEY=your_api_key_here

# M2-her generation parameters (optional — defaults shown)
M2_TEMPERATURE=1.0
M2_TOP_P=0.95
M2_MAX_TOKENS=2048

# CORS allowed origins (comma-separated). Default: localhost dev ports.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Application log level (DEBUG, INFO, WARNING, ERROR). Default: INFO.
# LOG_LEVEL=INFO
